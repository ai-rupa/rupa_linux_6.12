From 21184d64899e24d64244d533897d3f680f7880cb Mon Sep 17 00:00:00 2001
From: Weiye Chen <weiye.chen@rock-chips.com>
Date: Sat, 16 May 2026 08:51:04 +0000
Subject: [PATCH 3/3] mutter: NV12/P010/NV15 DMA-buf EGL external OES realize
 path

realize_nv12_external_oes(): imports NV12 DMA-buf as single EGL image
  with BT.601 YUV hints; fds[1] validated before PLANE1 (ATS #436)
realize_p010_external_oes(): imports P010 DMA-buf with BT.709 hints;
  fds[1] validated before PLANE1 (ATS #436)
realize_nv15_external_oes(): imports NV15 (NV12_10LE40) DMA-buf directly
  via EGL_LINUX_DMA_BUF_EXT; PLANE0(fd[0]) + PLANE1(fd[1]) with BT.709;
  EGL error details logged on failure (ATS #122)
init_formats(): advertises NV12, P010, NV15 via add_format() when EGL
  reports modifier support (Mali G310 reports external-only modifiers)
meta_wayland_dma_buf_try_acquire_scanout(): return NULL for formats
  without format_info (e.g. NV15) instead of g_assert crash; NV15
  falls back to GL compositing path

Change-Id: I1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b
Signed-off-by: Weiye Chen <weiye.chen@rock-chips.com>
---
 src/wayland/meta-wayland-dma-buf.c | 636 ++++++++++++++++++++++++++++-
 1 file changed, 632 insertions(+), 4 deletions(-)

diff --git a/src/wayland/meta-wayland-dma-buf.c b/src/wayland/meta-wayland-dma-buf.c
index 77d55dc..f188b33 100644
--- a/src/wayland/meta-wayland-dma-buf.c
+++ b/src/wayland/meta-wayland-dma-buf.c
@@ -355,6 +355,10 @@ meta_wayland_dma_buf_feedback_copy (MetaWaylandDmaBufFeedback *feedback)
   return new_feedback;
 }

+static gboolean realize_nv12_external_oes (MetaWaylandBuffer *buffer, GError **error);
+static gboolean realize_nv15_external_oes (MetaWaylandBuffer *buffer, GError **error);
+static gboolean realize_p010_external_oes (MetaWaylandBuffer *buffer, GError **error);
+
 static gboolean
 meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
                                       GError            **error)
@@ -378,6 +382,8 @@ meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
   format_info = meta_format_info_from_drm_format (dma_buf->drm_format);
   if (!format_info)
     {
+      if (dma_buf->drm_format == DRM_FORMAT_NV15)
+        return realize_nv15_external_oes (buffer, error);
       g_set_error (error, G_IO_ERROR,
                    G_IO_ERROR_FAILED,
                    "Unsupported buffer format %d", dma_buf->drm_format);
@@ -403,6 +409,7 @@ meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
       uint64_t modifiers[META_WAYLAND_DMA_BUF_MAX_FDS];
       uint32_t n_planes;

+
       for (n_planes = 0; n_planes < META_WAYLAND_DMA_BUF_MAX_FDS; n_planes++)
         {
           if (dma_buf->fds[n_planes] < 0)
@@ -485,7 +492,23 @@ meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
                                                     &dma_buf->drm_modifier,
                                                     error);
           if (egl_image == EGL_NO_IMAGE_KHR)
-            return FALSE;
+            {
+              /* For NV12, GR88 UV-plane import may fail on some GPUs.
+               * Fall back to full-buffer EXT_OES import path. */
+              if (multi_format == META_MULTI_TEXTURE_FORMAT_NV12)
+                {
+                  g_clear_error (error);
+                  g_ptr_array_set_size (planes, 0);
+                  return realize_nv12_external_oes (buffer, error);
+                }
+              if (multi_format == META_MULTI_TEXTURE_FORMAT_P010)
+                {
+                  g_clear_error (error);
+                  g_ptr_array_set_size (planes, 0);
+                  return realize_p010_external_oes (buffer, error);
+                }
+              return FALSE;
+            }

           flags = COGL_EGL_IMAGE_FLAG_NO_GET_DATA;
           cogl_texture = cogl_texture_2d_new_from_egl_image (cogl_context,
@@ -499,7 +522,21 @@ meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
           meta_egl_destroy_image (egl, egl_display, egl_image, NULL);

           if (!cogl_texture)
-            return FALSE;
+            {
+              if (multi_format == META_MULTI_TEXTURE_FORMAT_NV12)
+                {
+                  g_clear_error (error);
+                  g_ptr_array_set_size (planes, 0);
+                  return realize_nv12_external_oes (buffer, error);
+                }
+              if (multi_format == META_MULTI_TEXTURE_FORMAT_P010)
+                {
+                  g_clear_error (error);
+                  g_ptr_array_set_size (planes, 0);
+                  return realize_p010_external_oes (buffer, error);
+                }
+              return FALSE;
+            }

           g_ptr_array_add (planes, cogl_texture);
         }
@@ -515,6 +552,423 @@ meta_wayland_dma_buf_realize_texture (MetaWaylandBuffer  *buffer,
   return TRUE;
 }

+/* Context data for the cogl external-OES texture alloc callback. */
+typedef struct _NV12ExternalOesData
+{
+  MetaEgl    *egl;
+  EGLDisplay  egl_display;
+  EGLImageKHR egl_image;
+} NV12ExternalOesData;
+
+static void
+nv12_external_oes_data_free (gpointer user_data)
+{
+  NV12ExternalOesData *d = user_data;
+
+  meta_egl_destroy_image (d->egl, d->egl_display, d->egl_image, NULL);
+  g_free (d);
+}
+
+/* GL_TEXTURE_EXTERNAL_OES is defined in GL/gl2ext.h (Android / GLES2 ext).
+ * mutter does not include that header directly, so define it here. */
+#ifndef GL_TEXTURE_EXTERNAL_OES
+#define GL_TEXTURE_EXTERNAL_OES 0x8D65
+#endif
+
+/* typedef for glEGLImageTargetTexture2DOES (OES_EGL_image extension). */
+typedef void (*GlEGLImageTargetTexture2DOES_func) (GLenum target,
+                                                   GLeglImageOES image);
+
+/* Alloc callback invoked by cogl after binding the GL_TEXTURE_EXTERNAL_OES
+ * target.  We attach the pre-created NV12 EGL image to the external texture
+ * via glEGLImageTargetTexture2DOES so the GPU can sample both Y and UV planes
+ * through a single samplerExternalOES handle. */
+static gboolean
+alloc_nv12_external_oes (CoglTexture2D  *texture,
+                         gpointer        user_data,
+                         GError        **error)
+{
+  NV12ExternalOesData *d = user_data;
+  CoglContext *cogl_ctx;
+  CoglDisplay *cogl_display;
+  CoglRenderer *cogl_renderer;
+  GlEGLImageTargetTexture2DOES_func glEGLImageTargetTexture2DOES_fn;
+
+  cogl_ctx = cogl_texture_get_context (COGL_TEXTURE (texture));
+  cogl_display = cogl_context_get_display (cogl_ctx);
+  cogl_renderer = cogl_display_get_renderer (cogl_display);
+
+  glEGLImageTargetTexture2DOES_fn = (GlEGLImageTargetTexture2DOES_func)
+    cogl_renderer_get_proc_address (cogl_renderer,
+                                    "glEGLImageTargetTexture2DOES");
+  if (!glEGLImageTargetTexture2DOES_fn)
+    {
+      g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_FAILED,
+                           "NV12 external OES: glEGLImageTargetTexture2DOES "
+                           "not available — GL_OES_EGL_image not supported");
+      return FALSE;
+    }
+
+  /* cogl has already bound the texture to GL_TEXTURE_EXTERNAL_OES.
+   * Attach the multi-plane NV12 EGL image to it. */
+  glEGLImageTargetTexture2DOES_fn (GL_TEXTURE_EXTERNAL_OES,
+                                   (GLeglImageOES) d->egl_image);
+  return TRUE;
+}
+
+/* NV15 (NV12_10LE40, DRM_FORMAT_NV15) via GL_OES_EGL_image_external.
+ * Mali G310 reports NV15 with external=1 modifiers, meaning it can only
+ * be imported as GL_TEXTURE_EXTERNAL_OES (not per-plane).  The GPU driver
+ * performs 10-bit YUV->RGB conversion internally via BT.709 hints.
+ * No RGA conversion needed. */
+static gboolean
+realize_nv15_external_oes (MetaWaylandBuffer  *buffer,
+                            GError            **error)
+{
+  MetaWaylandDmaBufBuffer *dma_buf = buffer->dma_buf.dma_buf;
+
+  MetaContext *context =
+    meta_wayland_compositor_get_context (buffer->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaEgl *egl = meta_backend_get_egl (backend);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context = clutter_backend_get_cogl_context (clutter_backend);
+  EGLDisplay egl_display = cogl_context_get_egl_display (cogl_context);
+  NV12ExternalOesData *oes_data;
+  EGLImageKHR egl_image;
+  CoglTexture *texture;
+  uint64_t modifier;
+
+  modifier = dma_buf->drm_modifier;
+  if (modifier == DRM_FORMAT_MOD_INVALID)
+    modifier = DRM_FORMAT_MOD_LINEAR;
+
+  {
+    EGLint attribs[48];
+    int atti = 0;
+
+    attribs[atti++] = EGL_WIDTH;               attribs[atti++] = dma_buf->width;
+    attribs[atti++] = EGL_HEIGHT;              attribs[atti++] = dma_buf->height;
+    attribs[atti++] = EGL_LINUX_DRM_FOURCC_EXT; attribs[atti++] = DRM_FORMAT_NV15;
+    attribs[atti++] = EGL_IMAGE_PRESERVED_KHR;  attribs[atti++] = EGL_TRUE;
+
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_FD_EXT;          attribs[atti++] = dma_buf->fds[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT;      attribs[atti++] = dma_buf->offsets[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;       attribs[atti++] = dma_buf->strides[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT; attribs[atti++] = modifier & 0xFFFFFFFF;
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT; attribs[atti++] = modifier >> 32;
+
+    /* Plane 1 - UV: pass fds[1] per Weston import_simple_dmabuf convention */
+    if (dma_buf->fds[1] >= 0)
+      {
+        attribs[atti++] = EGL_DMA_BUF_PLANE1_FD_EXT;          attribs[atti++] = dma_buf->fds[1];
+        attribs[atti++] = EGL_DMA_BUF_PLANE1_OFFSET_EXT;      attribs[atti++] = dma_buf->offsets[1];
+        attribs[atti++] = EGL_DMA_BUF_PLANE1_PITCH_EXT;       attribs[atti++] = dma_buf->strides[1];
+        attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT; attribs[atti++] = modifier & 0xFFFFFFFF;
+        attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT; attribs[atti++] = modifier >> 32;
+      }
+
+    /* Mali G310 requires YUV hints (Weston patch 0018 adds same for is_mali_egl).
+     * Use BT.709 for H.264 High 10-bit 4K (same as P010 path). */
+    attribs[atti++] = EGL_YUV_COLOR_SPACE_HINT_EXT; attribs[atti++] = EGL_ITU_REC709_EXT;
+    attribs[atti++] = EGL_SAMPLE_RANGE_HINT_EXT;    attribs[atti++] = EGL_YUV_NARROW_RANGE_EXT;
+
+    attribs[atti++] = EGL_NONE;
+
+    egl_image = meta_egl_create_image (egl, egl_display, EGL_NO_CONTEXT,
+                                       EGL_LINUX_DMA_BUF_EXT, NULL,
+                                       attribs, error);
+    if (egl_image == EGL_NO_IMAGE_KHR)
+      {
+        EGLint egl_err = eglGetError ();
+        g_warning ("NV15 ext OES: eglCreateImageKHR failed: EGL error 0x%04x "
+                   "w=%d h=%d fds=[%d,%d] strides=[%d,%d] offsets=[%d,%d] mod=0x%llx",
+                   egl_err,
+                   dma_buf->width, dma_buf->height,
+                   dma_buf->fds[0], dma_buf->fds[1],
+                   dma_buf->strides[0], dma_buf->strides[1],
+                   dma_buf->offsets[0], dma_buf->offsets[1],
+                   (unsigned long long) modifier);
+        g_prefix_error (error,
+                        "NV15 external OES: EGL image creation failed (0x%04x): ",
+                        egl_err);
+        return FALSE;
+      }
+  }
+
+  oes_data = g_new0 (NV12ExternalOesData, 1);
+  oes_data->egl         = egl;
+  oes_data->egl_display = egl_display;
+  oes_data->egl_image   = egl_image;
+
+  texture = cogl_texture_2d_new_from_egl_image_external (
+      cogl_context,
+      dma_buf->width, dma_buf->height,
+      alloc_nv12_external_oes,
+      oes_data,
+      nv12_external_oes_data_free,
+      error);
+  if (!texture)
+    {
+      nv12_external_oes_data_free (oes_data);
+      return FALSE;
+    }
+
+  if (!cogl_texture_allocate (texture, error))
+    {
+      g_object_unref (texture);
+      return FALSE;
+    }
+
+  /* meta_multi_texture_new takes transfer-full of the textures array. */
+  {
+    CoglTexture **textures = g_new (CoglTexture *, 1);
+    textures[0] = texture;
+    buffer->dma_buf.texture =
+      meta_multi_texture_new (META_MULTI_TEXTURE_FORMAT_NV12_EXT_OES,
+                              textures, 1);
+  }
+  buffer->is_y_inverted = dma_buf->is_y_inverted;
+  return TRUE;
+}
+
+/* P010 (10-bit NV12) via GL_OES_EGL_image_external: same approach as NV12
+ * but with BT.709 color space hints for standard SDR 10-bit content. */
+static gboolean
+realize_p010_external_oes (MetaWaylandBuffer  *buffer,
+                           GError            **error)
+{
+  MetaWaylandDmaBufBuffer *dma_buf = buffer->dma_buf.dma_buf;
+  MetaContext *context =
+    meta_wayland_compositor_get_context (buffer->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaEgl *egl = meta_backend_get_egl (backend);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context = clutter_backend_get_cogl_context (clutter_backend);
+  EGLDisplay egl_display = cogl_context_get_egl_display (cogl_context);
+  NV12ExternalOesData *oes_data;
+  EGLImageKHR egl_image;
+  CoglTexture *texture;
+  uint64_t modifiers[2];
+
+  modifiers[0] = modifiers[1] =
+    (dma_buf->drm_modifier == DRM_FORMAT_MOD_INVALID)
+    ? DRM_FORMAT_MOD_LINEAR
+    : dma_buf->drm_modifier;
+
+  {
+    EGLint attribs[52];
+    int atti = 0;
+    uint64_t mod = modifiers[0];
+
+    attribs[atti++] = EGL_WIDTH;              attribs[atti++] = dma_buf->width;
+    attribs[atti++] = EGL_HEIGHT;             attribs[atti++] = dma_buf->height;
+    attribs[atti++] = EGL_LINUX_DRM_FOURCC_EXT; attribs[atti++] = DRM_FORMAT_P010;
+    attribs[atti++] = EGL_IMAGE_PRESERVED_KHR;  attribs[atti++] = EGL_TRUE;
+
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_FD_EXT;     attribs[atti++] = dma_buf->fds[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT; attribs[atti++] = dma_buf->offsets[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;  attribs[atti++] = dma_buf->strides[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT; attribs[atti++] = mod & 0xFFFFFFFF;
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT; attribs[atti++] = mod >> 32;
+
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_FD_EXT;     attribs[atti++] = dma_buf->fds[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_OFFSET_EXT; attribs[atti++] = dma_buf->offsets[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_PITCH_EXT;  attribs[atti++] = dma_buf->strides[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT; attribs[atti++] = mod & 0xFFFFFFFF;
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT; attribs[atti++] = mod >> 32;
+
+    /* BT.709 for standard SDR 10-bit content (same narrow range as NV12). */
+    attribs[atti++] = EGL_YUV_COLOR_SPACE_HINT_EXT;  attribs[atti++] = EGL_ITU_REC709_EXT;
+    attribs[atti++] = EGL_SAMPLE_RANGE_HINT_EXT;     attribs[atti++] = EGL_YUV_NARROW_RANGE_EXT;
+
+    attribs[atti++] = EGL_NONE;
+
+    egl_image = meta_egl_create_image (egl, egl_display, EGL_NO_CONTEXT,
+                                       EGL_LINUX_DMA_BUF_EXT, NULL,
+                                       attribs, error);
+  }
+
+  if (egl_image == EGL_NO_IMAGE_KHR)
+    {
+      g_prefix_error (error, "P010 external OES: EGL image creation failed: ");
+      return FALSE;
+    }
+
+  oes_data = g_new0 (NV12ExternalOesData, 1);
+  oes_data->egl = egl;
+  oes_data->egl_display = egl_display;
+  oes_data->egl_image = egl_image;
+
+  texture = cogl_texture_2d_new_from_egl_image_external (
+    cogl_context,
+    dma_buf->width, dma_buf->height,
+    alloc_nv12_external_oes,
+    oes_data,
+    nv12_external_oes_data_free,
+    error);
+
+  if (!texture)
+    {
+      nv12_external_oes_data_free (oes_data);
+      return FALSE;
+    }
+
+  if (!cogl_texture_allocate (texture, error))
+    {
+      g_object_unref (texture);
+      return FALSE;
+    }
+
+  {
+    CoglTexture **textures = g_new (CoglTexture *, 1);
+    textures[0] = texture;
+    buffer->dma_buf.texture =
+      meta_multi_texture_new (META_MULTI_TEXTURE_FORMAT_P010_EXT_OES,
+                              textures, 1);
+  }
+  buffer->is_y_inverted = dma_buf->is_y_inverted;
+  return TRUE;
+}
+
+/* NV12 on Mali G310: instead of splitting into Y (R8) + UV (RG88) planes —
+ * which fails because GR88 EGL import is unsupported on this GPU — import
+ * the entire NV12 DMA-buf as a single EGL image describing both planes.
+ * Mali G310 supports DRM_FORMAT_NV12 full-buffer import via
+ * EGL_EXT_image_dma_buf_import even though per-plane GR88 import fails.
+ * The resulting GL_TEXTURE_EXTERNAL_OES texture is sampled with a BT.601
+ * YUV→RGB shader, giving correct GPU-composited colour output at full
+ * frame rate (no SHM fallback, no KMS scanout required). */
+static gboolean
+realize_nv12_external_oes (MetaWaylandBuffer  *buffer,
+                           GError            **error)
+{
+  MetaWaylandDmaBufBuffer *dma_buf = buffer->dma_buf.dma_buf;
+  MetaContext *context =
+    meta_wayland_compositor_get_context (buffer->compositor);
+  MetaBackend *backend = meta_context_get_backend (context);
+  MetaEgl *egl = meta_backend_get_egl (backend);
+  ClutterBackend *clutter_backend = meta_backend_get_clutter_backend (backend);
+  CoglContext *cogl_context = clutter_backend_get_cogl_context (clutter_backend);
+  EGLDisplay egl_display = cogl_context_get_egl_display (cogl_context);
+  NV12ExternalOesData *oes_data;
+  EGLImageKHR egl_image;
+  CoglTexture *texture;
+  uint64_t modifiers[2];
+
+  /* Build modifier array for both planes (same modifier for NV12).
+   * DRM_FORMAT_MOD_INVALID from the client means "no specific modifier",
+   * which typically implies a linear allocation.  Mali G310 advertises
+   * DRM_FORMAT_MOD_LINEAR (0x0) for NV12 but NOT DRM_FORMAT_MOD_INVALID;
+   * always pass DRM_FORMAT_MOD_LINEAR explicitly so the EGL import succeeds. */
+  modifiers[0] = modifiers[1] =
+    (dma_buf->drm_modifier == DRM_FORMAT_MOD_INVALID)
+    ? DRM_FORMAT_MOD_LINEAR
+    : dma_buf->drm_modifier;
+
+  /* Import the complete NV12 buffer (Y + UV) as a single EGL image.
+   * Mali G310 requires EGL_YUV_COLOR_SPACE_HINT_EXT and EGL_SAMPLE_RANGE_HINT_EXT
+   * to correctly import NV12 — without them eglCreateImageKHR fails or returns
+   * an unusable image (Weston has the same HACK for Mali in import_simple_dmabuf).
+   * Build the attribute array manually so we can append these Mali-specific hints. */
+  {
+    EGLint attribs[52];
+    int atti = 0;
+    uint64_t mod = modifiers[0];
+
+    attribs[atti++] = EGL_WIDTH;              attribs[atti++] = dma_buf->width;
+    attribs[atti++] = EGL_HEIGHT;             attribs[atti++] = dma_buf->height;
+    attribs[atti++] = EGL_LINUX_DRM_FOURCC_EXT; attribs[atti++] = DRM_FORMAT_NV12;
+    attribs[atti++] = EGL_IMAGE_PRESERVED_KHR;  attribs[atti++] = EGL_TRUE;
+
+    /* Plane 0 – Y */
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_FD_EXT;     attribs[atti++] = dma_buf->fds[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT; attribs[atti++] = dma_buf->offsets[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;  attribs[atti++] = dma_buf->strides[0];
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT; attribs[atti++] = mod & 0xFFFFFFFF;
+    attribs[atti++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT; attribs[atti++] = mod >> 32;
+
+    /* Plane 1 – UV */
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_FD_EXT;     attribs[atti++] = dma_buf->fds[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_OFFSET_EXT; attribs[atti++] = dma_buf->offsets[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_PITCH_EXT;  attribs[atti++] = dma_buf->strides[1];
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT; attribs[atti++] = mod & 0xFFFFFFFF;
+    attribs[atti++] = EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT; attribs[atti++] = mod >> 32;
+
+    /* Mali G310 requires these YUV hints (BT.601, limited/narrow range).
+     * Weston has the same workaround in import_simple_dmabuf for is_mali_egl. */
+    attribs[atti++] = EGL_YUV_COLOR_SPACE_HINT_EXT;  attribs[atti++] = EGL_ITU_REC601_EXT;
+    attribs[atti++] = EGL_SAMPLE_RANGE_HINT_EXT;     attribs[atti++] = EGL_YUV_NARROW_RANGE_EXT;
+
+    attribs[atti++] = EGL_NONE;
+
+    egl_image = meta_egl_create_image (egl, egl_display, EGL_NO_CONTEXT,
+                                       EGL_LINUX_DMA_BUF_EXT, NULL,
+                                       attribs, error);
+  }
+
+  if (egl_image == EGL_NO_IMAGE_KHR)
+    {
+      EGLint egl_err = eglGetError ();
+      g_warning ("NV12 ext OES: eglCreateImageKHR failed: EGL error 0x%04x "
