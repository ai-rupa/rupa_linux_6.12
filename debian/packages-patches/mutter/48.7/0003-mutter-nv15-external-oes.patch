+/* Check whether every plane of a multi-texture format can be independently
+ * imported as an EGLImage from a DMA-buf.  If any plane's DRM format is not
+ * supported by the EGL driver (e.g. GR88 on Mali G310), the compositor cannot
+ * GL-composite the format and it must be excluded from the general dmabuf
+ * advertisement.  Such formats may still be used through the KMS scanout
+ * tranche advertised via zwp_linux_dmabuf_feedback_v1. */
+static gboolean
+can_gl_import_all_planes (MetaEgl              *egl,
+                           EGLDisplay            egl_display,
+                           const MetaFormatInfo *format_info)
+{
+  const MetaMultiTextureFormatInfo *mt_info;
+  int j;
+
+  if (format_info->multi_texture_format == META_MULTI_TEXTURE_FORMAT_SIMPLE)
+    return TRUE;
+
+  mt_info = meta_multi_texture_format_get_info (format_info->multi_texture_format);
+  if (!mt_info)
+    return FALSE;
+
+  for (j = 0; j < mt_info->n_planes; j++)
+    {
+      const MetaFormatInfo *plane_format;
+      EGLint num_mods = 0;
+
+      plane_format = meta_format_info_from_cogl_format (mt_info->subformats[j]);
+      if (!plane_format)
+        return FALSE;
+
+      /* A successful query with at least one modifier means EGL can import
+       * this plane format as a DMA-buf EGLImage. */
+      if (!meta_egl_query_dma_buf_modifiers (egl, egl_display,
+                                             plane_format->drm_format,
+                                             0, NULL, NULL, &num_mods, NULL)
+          || num_mods == 0)
+        {
+          meta_topic (META_DEBUG_WAYLAND,
+                      "Excluding DRM format 0x%x from GL dmabuf list: "
+                      "plane %d format 0x%x not EGL-importable",
+                      format_info->drm_format, j,
+                      plane_format->drm_format);
+          return FALSE;
+        }
+    }
+
+  return TRUE;
+}
