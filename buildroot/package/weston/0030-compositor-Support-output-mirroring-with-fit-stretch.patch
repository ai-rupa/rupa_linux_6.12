 #endif
diff --git a/libweston/backend-drm/state-propose.c b/libweston/backend-drm/state-propose.c
index 9e4c1f19..80a547ec 100644
--- a/libweston/backend-drm/state-propose.c
+++ b/libweston/backend-drm/state-propose.c
@@ -1556,7 +1556,8 @@ drm_assign_planes(struct weston_output *output_base)
 		drm_debug(b, "\t[repaint] could not reuse prior state\n");
 
 	if (!state && !device->disable_client_buffer_scanout &&
-	    !output_base->disable_planes && !output->is_virtual && b->gbm) {
