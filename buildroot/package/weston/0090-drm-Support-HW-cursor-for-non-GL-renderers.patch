@@ -3065,6 +3098,8 @@ drm_output_deinit(struct weston_output *base)
 	else
 		drm_output_fini_egl(output);
 
+	drm_output_fini_cursor(output);
+
 	drm_output_detach_crtc(output);
 
 	output->blend_to_output_xform = NULL;
