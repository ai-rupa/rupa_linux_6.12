From 0cbe6f04013ded8ffc3513bd4a41e72e1a063163 Mon Sep 17 00:00:00 2001
From: Jeffy Chen <jeffy.chen@rock-chips.com>
Date: Wed, 28 Sep 2022 10:44:07 +0800
Subject: [PATCH 62/98] compositor: Stop bootanim when first desktop surface
 appears

Add a hack to stop the bootanim process when the first desktop surface
is detected, allowing the boot animation to exit when applications start.

Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
---
 libweston/compositor.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/libweston/compositor.c b/libweston/compositor.c
index 9476e38c..a459e74e 100644
--- a/libweston/compositor.c
+++ b/libweston/compositor.c
@@ -4311,6 +4311,19 @@ weston_output_should_freeze(struct weston_output *output)
 	if (timespec_sub_to_msec(&output->freeze_until, &now) > 0)
 		return true;
 
+	/* HACK: Try to stop the custom bootanim when first app appears.
+	 * This is a Rockchip-specific hack to stop the boot animation
+	 * when the first desktop application surface is detected.
+	 */
+	{
+#define BOOTANIM "/usr/bin/bootanim"
+		static bool ready = false;
+		if (!ready && has_desktop_surface && !access(BOOTANIM, X_OK)) {
+			ready = true;
+			(void)!system(BOOTANIM " stop&");
+		}
+	}
+
 	if (!access(getenv("WESTON_FREEZE_DISPLAY") ? : "", F_OK))
 		return true;
 
-- 
