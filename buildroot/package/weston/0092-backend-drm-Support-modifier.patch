From 213eec1798fa366eeaf573d4503aa9812526c0e6 Mon Sep 17 00:00:00 2001
From: Jeffy Chen <jeffy.chen@rock-chips.com>
Date: Wed, 6 Jan 2021 04:11:48 +0800
Subject: [PATCH 92/98] backend-drm: Support modifier

Add DRM format modifier support for the DRM backend, enabling GBM
surface creation with modifiers and modifier-aware plane selection.
Modifiers are disabled by default and can be enabled via the
WESTON_ALLOW_GBM_MODIFIERS environment variable.

Tested on rk3588 with:
unset WESTON_DISABLE_ATOMIC
export WESTON_ALLOW_GBM_MODIFIERS=1
export DRM_PLANE_TYPE_148=primary
export DRM_PLANE_TYPE_132=overlay
weston&

Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
---
 libweston/backend-drm/drm-gbm.c      | 18 +++++++-
 libweston/backend-drm/drm-internal.h |  3 ++
 libweston/backend-drm/drm.c          | 65 ++++++++++++++++++++++++++++
 libweston/backend-drm/kms.c          |  5 ++-
 libweston/pixel-formats.c            |  1 +
 5 files changed, 89 insertions(+), 3 deletions(-)

diff --git a/libweston/backend-drm/drm-gbm.c b/libweston/backend-drm/drm-gbm.c
index d7084856..787939ba 100644
--- a/libweston/backend-drm/drm-gbm.c
+++ b/libweston/backend-drm/drm-gbm.c
@@ -146,6 +146,7 @@ create_gbm_surface(struct gbm_device *gbm, struct drm_output *output)
 {
 	struct weston_mode *mode = output->base.current_mode;
 	struct drm_plane *plane = output->scanout_handle->plane;
+	struct drm_device *device = output->device;
 	struct weston_drm_format *fmt;
 	const uint64_t *modifiers;
 	unsigned int num_modifiers;
@@ -159,9 +160,22 @@ create_gbm_surface(struct gbm_device *gbm, struct drm_output *output)
 		return;
 	}
 
-	if (!weston_drm_format_has_modifier(fmt, DRM_FORMAT_MOD_INVALID) &&
-	    !weston_drm_format_has_modifier(fmt, DRM_FORMAT_MOD_LINEAR)) {
+	/* HACK: Prefer valid modifiers when fb_modifiers is enabled.
+	 * Note: modifiers pointer is reassigned to local array, but
+	 * gbm_surface_create_with_modifiers copies the data, so this is safe.
+	 */
+	if (device->fb_modifiers) {
+#define MAX_MODIFIERS 128
+		uint64_t _modifiers[MAX_MODIFIERS];
+		int i, j;
 		modifiers = weston_drm_format_get_modifiers(fmt, &num_modifiers);
+		for (i = 0, j = 0; i < (int)num_modifiers; i++) {
+			if (DRM_MOD_VALID(modifiers[i]) && j < MAX_MODIFIERS)
+				_modifiers[j++] = modifiers[i];
+		}
+		modifiers = _modifiers;
+		num_modifiers = j;
+
 		output->gbm_surface =
 			gbm_surface_create_with_modifiers(gbm,
 							  mode->width, mode->height,
diff --git a/libweston/backend-drm/drm-internal.h b/libweston/backend-drm/drm-internal.h
index 9140ddb0..348dcfee 100644
--- a/libweston/backend-drm/drm-internal.h
+++ b/libweston/backend-drm/drm-internal.h
@@ -495,6 +495,9 @@ struct drm_plane {
 	struct weston_drm_format_array formats;
 
 	bool can_scale;
+
+	/* True if plane supports any valid (non-linear/invalid) modifiers. */
+	bool has_modifiers;
 };
 
 struct drm_plane_handle {
diff --git a/libweston/backend-drm/drm.c b/libweston/backend-drm/drm.c
index 2a0ba88f..038a5bc7 100644
--- a/libweston/backend-drm/drm.c
+++ b/libweston/backend-drm/drm.c
@@ -1516,6 +1516,44 @@ err:
 	return NULL;
 }
 
+/* Check if plane supports any valid modifier (excluding INVALID and LINEAR)
+ * for a format. */
+static inline bool
+drm_plane_has_modifier(struct drm_plane *plane, uint32_t format)
+{
+	struct weston_drm_format *fmt;
+	const uint64_t *modifiers;
+	unsigned int num_modifiers, i;
+
+	fmt = weston_drm_format_array_find_format(&plane->formats, format);
+	if (!fmt)
+		return false;
+
+	modifiers = weston_drm_format_get_modifiers(fmt, &num_modifiers);
+	for (i = 0; i < num_modifiers; i++) {
+		if (DRM_MOD_VALID(modifiers[i]))
+			return true;
+	}
+
+	return false;
+}
+
+static inline bool
+drm_planes_have_modifier(struct drm_device *device)
+{
+	struct drm_plane *plane;
+
+	if (!device->fb_modifiers)
+		return false;
+
+	wl_list_for_each_reverse(plane, &device->plane_list, link) {
+		if (plane->has_modifiers)
+			return true;
+	}
+
+	return false;
+}
+
 /**
  * Find, or create, a special-purpose plane
  *
@@ -1530,7 +1568,14 @@ drm_output_find_special_plane(struct drm_device *device,
 {
 	struct drm_backend *b = device->backend;
 	struct drm_plane *plane;
+	bool prefer_modifier =
+		device->fb_modifiers && type == WDRM_PLANE_TYPE_PRIMARY;
 
+	/* First try to find a plane that supports modifiers for the output
+	 * format, then fall back to any plane if not found or if modifiers
+	 * are not required.
+	 */
+retry:
 	wl_list_for_each(plane, &device->plane_list, link) {
 		struct weston_output *base;
 		bool found_elsewhere = false;
@@ -1567,10 +1612,27 @@ drm_output_find_special_plane(struct drm_device *device,
 		    (plane->crtc_id != output->crtc->crtc_id))
 			continue;
 
+		/* HACK: Force XBGR8888 for modifier support
+		 * (platform-specific)
+		 */
+		if (prefer_modifier) {
+			if (!drm_plane_has_modifier(plane, DRM_FORMAT_XBGR8888))
+				continue;
+
+			output->format =
+				pixel_format_get_info(DRM_FORMAT_XBGR8888);
+		}
+
 		plane->possible_crtcs = (1 << output->crtc->pipe);
 		return plane;
 	}
 
+	/* Fallback: retry without modifier preference */
+	if (prefer_modifier) {
+		prefer_modifier = false;
+		goto retry;
+	}
+
 	return NULL;
 }
 
@@ -4771,6 +4833,9 @@ drm_backend_create(struct weston_compositor *compositor,
 	}
 	b->drm = device;
 
+	if (!drm_planes_have_modifier(b->drm))
+		device->fb_modifiers = false;
+
 	if (config->additional_devices)
 		open_additional_devices(b, config->additional_devices);
 
diff --git a/libweston/backend-drm/kms.c b/libweston/backend-drm/kms.c
index 5ef6f81c..4fe65ebd 100644
--- a/libweston/backend-drm/kms.c
+++ b/libweston/backend-drm/kms.c
@@ -36,6 +36,7 @@
 
 #include <libweston/libweston.h>
 #include <libweston/backend-drm.h>
+#include <libweston/linux-dmabuf.h>
 #include "shared/helpers.h"
 #include "shared/weston-drm-fourcc.h"
 #include "drm-internal.h"
@@ -725,6 +726,8 @@ drm_plane_populate_formats(struct drm_plane *plane, const drmModePlane *kplane,
 		if (ret < 0)
 			goto out;
 
+		if (DRM_MOD_VALID(drm_iter.mod))
+			plane->has_modifiers = true;
 	}
 
 out:
@@ -2194,7 +2197,7 @@ init_kms_caps(struct drm_device *device)
 	weston_log("DRM: %s atomic modesetting\n",
 		   device->atomic_modeset ? "supports" : "does not support");
 
-	if (!getenv("WESTON_DISABLE_GBM_MODIFIERS")) {
+	if (getenv("WESTON_ALLOW_GBM_MODIFIERS")) {
 		ret = drmGetCap(device->kms_device->fd, DRM_CAP_ADDFB2_MODIFIERS, &cap);
 		if (ret == 0)
 			device->fb_modifiers = cap;
diff --git a/libweston/pixel-formats.c b/libweston/pixel-formats.c
index 91ce8af7..47b743e2 100644
--- a/libweston/pixel-formats.c
+++ b/libweston/pixel-formats.c
@@ -448,6 +448,7 @@ static const struct pixel_format_info pixel_format_table[] = {
 		DRM_FORMAT(XBGR8888),
 		COLOR_MODEL(RGB),
 		BITS_RGBA_FIXED(8, 8, 8, 0),
+		.addfb_legacy_depth = 24,
 		.bpp = 32,
 		GL_FORMAT_INFO(GL_RGBA8, GL_RGBA, GL_UNSIGNED_BYTE, RGB1),
 		GL_FORMAT(GL_RGBA),
-- 
