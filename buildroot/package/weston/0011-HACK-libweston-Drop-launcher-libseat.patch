From 7e515f30f1c24bee61c5ee3c74f10588c38d6f65 Mon Sep 17 00:00:00 2001
From: Jeffy Chen <jeffy.chen@rock-chips.com>
Date: Mon, 11 Dec 2023 18:06:01 +0800
Subject: [PATCH 11/98] HACK: libweston: Drop launcher-libseat

Use launcher-direct instead.

Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
---
 libweston/launcher-util.c | 1 -
 libweston/meson.build     | 3 ---
 2 files changed, 4 deletions(-)

diff --git a/libweston/launcher-util.c b/libweston/launcher-util.c
index 64ce420e..6ee86eda 100644
--- a/libweston/launcher-util.c
+++ b/libweston/launcher-util.c
@@ -37,7 +37,6 @@
 #include <linux/input.h>
 
 static const struct launcher_interface *ifaces[] = {
-	&launcher_libseat_iface,
 	&launcher_direct_iface,
 	NULL,
 };
diff --git a/libweston/meson.build b/libweston/meson.build
index 8e90e89d..a4124358 100644
--- a/libweston/meson.build
+++ b/libweston/meson.build
@@ -188,15 +188,12 @@ pkgconfig.generate(
 )
 
 if get_option('backend-drm')
-	dep_libseat = dependency('libseat', version: '>= 0.4')
 	srcs_session_helper = [
-		'launcher-libseat.c',
 		'launcher-direct.c',
 		'launcher-util.c',
 	]
 	deps_session_helper = [
 		dep_libdrm,
-		dep_libseat,
 		dep_libweston_private_h,
 	]
 
-- 
2.39.5

