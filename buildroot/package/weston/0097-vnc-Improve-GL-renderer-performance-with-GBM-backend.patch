 libweston/backend-vnc/vnc.c                  | 269 +++++++++++++++++--
 libweston/renderer-gl/gl-renderer-internal.h |   2 +
 libweston/renderer-gl/gl-renderer.c          |  34 ++-
 libweston/renderer-gl/gl-renderer.h          |   9 +
 5 files changed, 285 insertions(+), 36 deletions(-)

