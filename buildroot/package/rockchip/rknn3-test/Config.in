config BR2_PACKAGE_RKNN3_TEST
	bool "rknn3-test"
	select BR2_PACKAGE_RKNPU2
	help
	  RKNN3 stress test and demo programs for Rockchip NPU.

if BR2_PACKAGE_RKNN3_TEST

config BR2_PACKAGE_RKNN3_TEST_CNN
	bool "rknn3_cnn_test"
	default y
	help
	  CNN model stress test

config BR2_PACKAGE_RKNN3_TEST_LLM
	bool "rknn3_llm_test"
	help
	  LLM model stress test

config BR2_PACKAGE_RKNN3_TEST_VLM
	bool "rknn3_vlm_test"
	help
	  VLM (Vision Language Model) stress test

config BR2_PACKAGE_RKNN3_TEST_AUDIO_ENCODER
	bool "rknn3_audio_encoder_test"
	help
	  Audio encoder stress test

config BR2_PACKAGE_RKNN3_TEST_TARGET_SOC
	string "Target SoC"
	default "rk3572"

endif
