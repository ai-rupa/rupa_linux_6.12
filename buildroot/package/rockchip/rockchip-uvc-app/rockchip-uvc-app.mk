################################################################################
#
# rockchip-uvc-app project
#
################################################################################

ROCKCHIP_UVC_APP_SITE = $(TOPDIR)/../external/uvc_app/src

ROCKCHIP_UVC_APP_SITE_METHOD = local

ROCKCHIP_UVC_APP_INSTALL_STAGING = YES

ROCKCHIP_UVC_APP_DEPENDENCIES = libdrm rockit camera-engine-rkaiq

ROCKCHIP_UVC_APP_LICENSE = ROCKCHIP
ROCKCHIP_UVC_APP_LICENSE_FILES = LICENSE

ROCKCHIP_UVC_APP_CHIP =
ifeq ($(BR2_PACKAGE_RV1126B),y)
ROCKCHIP_UVC_APP_CHIP = rv1126b
ROCKCHIP_UVC_APP_CMAKE_CHIP = RV1126B
else ifeq ($(BR2_PACKAGE_RK3588),y)
ROCKCHIP_UVC_APP_CHIP = rk3588
ROCKCHIP_UVC_APP_CMAKE_CHIP = RK3588
else ifeq ($(BR2_PACKAGE_RK3576),y)
ROCKCHIP_UVC_APP_CHIP = rk3576
ROCKCHIP_UVC_APP_CMAKE_CHIP = RK3576
else ifeq ($(BR2_PACKAGE_RK3572),y)
ROCKCHIP_UVC_APP_CHIP = rk3572
ROCKCHIP_UVC_APP_CMAKE_CHIP = RK3572
endif

ROCKCHIP_UVC_APP_PROFILE =
ifeq ($(BR2_PACKAGE_ROCKCHIP_UVC_APP_TYPE_4K),y)
ROCKCHIP_UVC_APP_PROFILE = 4K
else ifeq ($(BR2_PACKAGE_ROCKCHIP_UVC_APP_TYPE_WINHELLO),y)
ROCKCHIP_UVC_APP_PROFILE = WINHELLO
endif

ROCKCHIP_UVC_APP_CONF_OPTS = -DRK_APP_CHIP=$(ROCKCHIP_UVC_APP_CHIP)
ROCKCHIP_UVC_APP_CONF_OPTS += -DCOMPILE_FOR_BUILDROOT=ON

ifeq ($(BR2_PACKAGE_IVA),y)
ROCKCHIP_UVC_APP_DEPENDENCIES += iva
endif

ROCKCHIP_UVC_APP_CONF_OPTS += \
	$(if $(and $(ROCKCHIP_UVC_APP_PROFILE),$(ROCKCHIP_UVC_APP_CMAKE_CHIP)),\
	-DCOMPILE_FOR_UVC_TINY_$(ROCKCHIP_UVC_APP_CMAKE_CHIP)_$(ROCKCHIP_UVC_APP_PROFILE)=ON)

$(eval $(cmake-package))
