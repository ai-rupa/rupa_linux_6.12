config BR2_PACKAGE_IVA
	bool "rockiva algorithm"
	help
	  rockiva library

if BR2_PACKAGE_IVA

choice
	default BR2_PACKAGE_IVA_RK3588
	prompt "target platform(32bit/64bit)"

config BR2_PACKAGE_IVA_RK3572
        bool "rockiva rk3572"
        help
          Use rockiva for rk3572.

config BR2_PACKAGE_IVA_RK3576
	bool "rockiva rk3576"
	help
	  Use rockiva for rk3576.

config BR2_PACKAGE_IVA_RK3588
	bool "rockiva rk3588"
	help
	  Use rockiva for rk3588.

config BR2_PACKAGE_IVA_RV1106
	bool "rockiva rv1106"
	help
	  Use rockiva for rv1106.

config BR2_PACKAGE_IVA_RV1126B
	bool "rockiva rv1126b"
	help
	  Use rockiva for rv1126b.
endchoice

endif
