+static inline bool e1000e_in_primary_irqctx(struct e1000_adapter *adapter)
+{
+	if (!e1000e_net_oob() || running_oob())
+		return true;
+
+	if (adapter->flags2 & FLAG2_IN_NETPOLL)
+		return true;
+
+	return !netif_oob_diversion(adapter->netdev);
+}
