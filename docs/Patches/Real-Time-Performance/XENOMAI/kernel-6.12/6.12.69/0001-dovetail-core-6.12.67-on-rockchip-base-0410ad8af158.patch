+			irq_settings_set_oob(desc);
+		} else {
+			irq_settings_clr_oob(desc);
+		}
+	}
+out:
+	irq_put_desc_unlock(desc, flags);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(irq_switch_oob);
