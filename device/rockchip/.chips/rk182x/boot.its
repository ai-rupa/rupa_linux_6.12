/dts-v1/;
/ {
    description = "Linux kernel and FDT blob";
    #address-cells = <1>;

    images {
        fdt {
	    description = "Flattened Device Tree blob";
            data = /incbin/("@KERNEL_DTB@");
            type = "flat_dt";
            arch = "riscv";
            compression = "none";
	    load = /bits/ 64 <0x540300000>;

            hash {
                algo = "sha256";
            };
        };

        kernel {
	    description = "RK1820 Linux kernel";
            data = /incbin/("@KERNEL_IMG@");
            type = "kernel";
            arch = "riscv";
            os = "linux";
            compression = "none";
	    load = /bits/ 64 <0x540400000>;
	    entry = /bits/ 64 <0x540400000>;

            hash {
                algo = "sha256";
            };
        };
    };

    configurations {
        default = "conf";

        conf {
	    description = "Boot Linux kernel with FDT blob";
            fdt = "fdt";
            kernel = "kernel";

        };
    };
};
