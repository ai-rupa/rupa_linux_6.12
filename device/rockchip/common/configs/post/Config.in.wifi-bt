#

menuconfig RK_WIFIBT
	bool "Wi-Fi/BT (Kernel modules, firmwares and scripts)"
	default y if RK_CHIP_FAMILY != "rk182x"

if RK_WIFIBT

choice
	prompt "Userspace BT daemon"

config RK_WIFIBT_BT_DAEMON_DEFAULT
	bool "auto"
	help
	  Disabled for kernel version >6.1.

config RK_WIFIBT_BT_DAEMON_ENABLED
	bool "enable"

config RK_WIFIBT_BT_DAEMON_DISABLED
	bool "disable"

endchoice # BT daemon

config RK_WIFIBT_MODULES
	string
	default "ALL_AP" if RK_WIFIBT_AP
	default "ALL_CY" if RK_WIFIBT_CYW
	default RK_WIFIBT_CHIP if RK_WIFIBT_ON_BOARD

config RK_WIFIBT_CHIP
	string "onboard module"
	help
	  Onboard Wi-Fi/BT module.

choice
	prompt "supported modules"
	default RK_WIFIBT_ON_BOARD if RK_WIFIBT_CHIP != ""
	default RK_WIFIBT_AP

config RK_WIFIBT_AP
	bool "Broadcom(AP6XXX)"
	help
	  All Broadcom(AP6XXX) modules.

config RK_WIFIBT_CYW
	bool "Infineon(CYWXXX)"
	help
	  All Infineon(CYWXXX) modules.

config RK_WIFIBT_ON_BOARD
	bool "onboard module"
	help
	  Onboard module only.

endchoice # modules

endif # Wi-Fi/BT
endmenuconfig # Wi-Fi/BT
