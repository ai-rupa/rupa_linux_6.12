CONFIG_MALI_VALHALL=y
CONFIG_MALI_VALHALL_PLATFORM_NAME="rk"
CONFIG_MALI_VALHALL_EXPERT=y
CONFIG_MALI_VALHALL_DEBUG=y
# CONFIG_DMA_SHARED_BUFFER_TEST_EXPORTER=y

# Vendor storage: U-Boot reads it from the boot medium (eMMC: 3.5MB offset,
# SPI flash: "vnvm" partition) and passes the region to the kernel as
# reserved memory, so use the RAM backend rather than the MTD one.
CONFIG_ROCKCHIP_VENDOR_STORAGE=y
CONFIG_ROCKCHIP_RAM_VENDOR_STORAGE=y
# CONFIG_ROCKCHIP_MTD_VENDOR_STORAGE is not set
