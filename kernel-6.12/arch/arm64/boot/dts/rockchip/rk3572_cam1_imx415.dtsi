/*
 * IMX415 MIPI camera (CAM1) configuration for RK3572.
 *
 * Wiring:
 *   - sensor      : Sony IMX415, on I2C5 (i2c5m3: GPIO3_C1/C4), addr 0x1a
 *   - xvclk       : CAM_CLK0 output, M0 mux (GPIO3_D7, cam_clk0m0_clk0_pins)
 *   - MIPI        : CSI2 D-PHY RX, 4 data lanes
 *                   imx415 -> csi2_dphy0 -> mipi0_csi2 ->
 *                   rkcif_mipi_lvds -> rkisp_vir0 -> userspace
 *   - power en    : GPIO3_C5, active high (module power switch)
 *   - reset       : GPIO3_C7, active low
 */

/ {
	vcc_cam3: vcc-cam3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_cam3";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		gpio = <&gpio3 RK_PC5 GPIO_ACTIVE_HIGH>;
		//gpio = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc_3v3_s0>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc_cam3_pwr>;
	};
};

&i2c5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5m3_xfer_pins>;

	imx415_1a: imx415@1a {
		compatible = "sony,imx415";
		reg = <0x1a>;
		clocks = <&cru CAM_CLK0_OUT_IOUT>;
		//clocks = <&cru CAM_CLK1_OUT_IOUT>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0m0_clk0_pins &imx415_reset_pwr>;
		//pinctrl-0 = <&cam_clk1m0_clk1_pins &imx415_reset_pwr>;
		power-domains = <&power RK3572_PD_VI>;
		/* module power stays on via vcc_cam3, reset toggles the sensor */
		reset-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>;
		avdd-supply = <&vcc_cam3>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "CMK-OT2022-PX1";
		rockchip,camera-module-lens-name = "IR0147-50IRC-8M-F20";
		port {
			imx415_out0: endpoint {
				remote-endpoint = <&mipi_in_ucam0>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

/* CSI2 D-PHY RX, full mode, 4 lanes */
&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_in_ucam0: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx415_out0>;
				data-lanes = <1 2 3 4>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csidcphy0_out: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi0_csi2_input>;
			};
		};
	};
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidcphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkisp_vir0_sditf {
	status = "okay";
};

&rkvpss {
	status = "okay";
};

&rkvpss_mmu {
	status = "okay";
};

&rkvpss_vir0 {
	status = "okay";
};

&pinctrl {
	cam {
		vcc_cam3_pwr: vcc-cam3-pwr {
			/* camera power enable, active high */
			rockchip,pins = <3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
			//rockchip,pins = <3 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		imx415_reset_pwr: imx415-reset-pwr {
			/* imx415 XCLR, active low */
			rockchip,pins = <3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
